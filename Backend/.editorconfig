root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Alineado con detekt.yml
max_line_length = 120

# Reglas específicas de Kotlin
kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
disabled_rules = no-wildcard-imports

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4
